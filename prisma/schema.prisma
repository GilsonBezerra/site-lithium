generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkType {
  COMIC
  BOOK
  GAME
}

enum WorkStatus {
  IN_DEVELOPMENT
  AVAILABLE
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

model Work {
  id          String       @id @default(cuid())
  title       String
  type        WorkType
  status      WorkStatus   @default(IN_DEVELOPMENT)
  description String?
  coverImage  String
  price       Decimal?     @db.Decimal(10, 2)
  saleEnabled Boolean      @default(false)
  featured    Boolean      @default(false)
  order       Int          @default(0)
  credits     WorkCredit[]
  orders      Order[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([featured])
}

model WorkCredit {
  id     String @id @default(cuid())
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  role   String
  name   String
  order  Int    @default(0)
}

model Order {
  id             String         @id @default(cuid())
  workId         String
  work           Work           @relation(fields: [workId], references: [id])
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod?
  mpPreferenceId String?
  mpPaymentId    String?
  payerEmail     String
  amount         Decimal        @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([workId])
  @@index([status])
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  role     String
  photoUrl String
  twitter  String?
  facebook String?
  linkedin String?
  order    Int     @default(0)
}

model TimelineEntry {
  id          String  @id @default(cuid())
  year        String?
  title       String
  description String?
  isCta       Boolean @default(false)
  order       Int     @default(0)
}

model Admin {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
}
