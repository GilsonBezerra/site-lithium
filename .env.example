# SMTP (formulário de contato)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario@seudominio.com
SMTP_PASS=defina-esta-senha-apenas-no-arquivo-.env-local-nao-commitado
MAIL_TO=usuario@seudominio.com

# Banco de dados (Postgres — Neon, Railway, Supabase, etc.)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Cloudinary (upload de imagens no admin)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# NextAuth (área /admin)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32

# Admins (usados apenas pelo `npm run seed`, não em runtime)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=

# Mercado Pago (loja)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_ENABLED=false
NEXT_PUBLIC_PIX_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
